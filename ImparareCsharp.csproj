<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Il progetto UI vive in una sua cartella: il progetto console non deve compilarne i file -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);PasswordGeneratorUI/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
